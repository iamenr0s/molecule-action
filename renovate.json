{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^action\\.yml$/"],
      "matchStrings": [
        "image: 'docker://(?<depName>[^:]+):(?<currentValue>[^@']+)@(?<currentDigest>sha256:[a-f0-9]+)'"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
